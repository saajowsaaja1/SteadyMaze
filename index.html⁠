<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SteadyMaze | Global Luxury Education Ecosystem</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        luxury: {
                            black: '#050505',
                            charcoal: '#111111',
                            card: '#161618',
                            border: '#2A2A2E',
                            gold: '#D4AF37',
                            goldLight: '#F5D76E',
                            goldDark: '#B8860B',
                            grayText: '#B8B8B8'
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts & Lucide Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-luxury-black text-luxury-grayText font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-luxury-gold selection:text-black">

    <!-- LEFT SIDEBAR: FEATURE REQUEST CHAT -->
    <aside aria-label="Feature Request Panel" class="fixed left-6 bottom-6 z-50 hidden xl:block">
        <div class="glass-card w-72 p-4 rounded-2xl border border-luxury-gold/30 shadow-2xl shadow-luxury-gold/10">
            <div class="flex items-center space-x-2 mb-3">
                <i data-lucide="message-square-plus" class="w-4 h-4 text-luxury-gold"></i>
                <h4 class="text-xs font-bold text-white uppercase tracking-wider">Feature Requests</h4>
            </div>
            <p class="text-[11px] text-luxury-grayText mb-3">Submit your ideas for what we should add next to SteadyMaze platform.</p>
            <input type="text" placeholder="Suggest a feature..." class="w-full bg-luxury-black border border-luxury-border rounded-xl px-3 py-2 text-xs text-white mb-2 focus:outline-none focus:border-luxury-gold">
            <button onclick="alert('Feature request submitted to administrators.')" class="w-full py-2 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black font-bold text-xs shadow-lg shadow-luxury-gold/20">Submit Request</button>
        </div>
    </aside>

    <!-- NAVIGATION HEADER -->
    <header class="fixed top-0 left-0 right-0 z-50 glass-nav border-b border-luxury-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-luxury-goldLight to-luxury-goldDark flex items-center justify-center shadow-xl shadow-luxury-gold/20">
                    <i data-lucide="crown" class="w-5 h-5 text-black"></i>
                </div>
                <span class="text-xl font-extrabold tracking-wider uppercase text-white">Steady<span class="gold-gradient-text">Maze</span></span>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden xl:flex items-center space-x-4 text-xs font-semibold">
                <button onclick="switchTab('home')" class="nav-btn text-luxury-grayText hover:text-luxury-gold transition-colors">Home</button>
                <button onclick="switchTab('courses')" class="nav-btn text-luxury-grayText hover:text-luxury-gold transition-colors">Courses</button>
                <button onclick="switchTab('teachers')" class="nav-btn text-luxury-grayText hover:text-luxury-gold transition-colors">Teachers</button>
                <button onclick="switchTab('competition')" class="nav-btn text-luxury-gold transition-colors flex items-center space-x-1">
                    <i data-lucide="award" class="w-3.5 h-3.5"></i><span>Competition</span>
                </button>
                <button onclick="switchTab('community')" class="nav-btn text-luxury-grayText hover:text-luxury-gold transition-colors">Community</button>
                <button onclick="switchTab('marketplace')" class="nav-btn text-luxury-grayText hover:text-luxury-gold transition-colors">Marketplace</button>
                <button onclick="switchTab('signup')" class="nav-btn text-luxury-gold font-bold">Start Earning</button>
                <button onclick="switchTab('login')" class="nav-btn text-luxury-grayText hover:text-luxury-gold transition-colors">Login</button>
            </nav>

            <div class="hidden lg:flex items-center space-x-3">
                <button onclick="switchTab('signup')" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black text-xs font-bold shadow-lg shadow-luxury-gold/25 transition-all hover:scale-105">Sign Up</button>
            </div>
        </div>
    </header>

    <!-- MAIN DYNAMIC CONTENT -->
    <main class="flex-grow pt-28 pb-20">
        
        <!-- 1. HOME SECTION -->
        <section id="tab-home" class="tab-content active max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-16">
            <span class="px-4 py-1.5 rounded-full text-xs font-bold bg-luxury-gold/10 text-luxury-gold border border-luxury-gold/30 mb-6 inline-block uppercase tracking-widest shadow-lg shadow-luxury-gold/10">Global Luxury Education Ecosystem</span>
            <h1 class="text-5xl sm:text-7xl font-black mb-6 text-white tracking-tight">Steady<span class="gold-gradient-text">Maze</span></h1>
            <p class="text-lg text-luxury-grayText max-w-3xl mx-auto mb-10 leading-relaxed">Master 16 elite disciplines across Creative, Financial, and Development tracks with automated AI multi-language subtitles, dual-instructor masterclasses, and verified gold standards.</p>
            
            <!-- Real Search System -->
            <div class="max-w-2xl mx-auto mb-12">
                <div class="glass-card p-2 rounded-2xl border border-luxury-gold/30 flex items-center shadow-2xl">
                    <i data-lucide="search" class="w-5 h-5 text-luxury-gold ml-3 mr-2"></i>
                    <input type="text" id="global-search-input" oninput="handleSearch(this.value)" placeholder="Search courses, teachers, skills, categories..." class="w-full bg-transparent text-white text-xs focus:outline-none px-2">
                    <button onclick="switchTab('courses')" class="px-6 py-3 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black font-bold text-xs">Search</button>
                </div>
                <div id="search-results-dropdown" class="hidden mt-2 glass-card rounded-2xl border border-luxury-gold/20 p-4 text-left max-h-60 overflow-y-auto space-y-2 text-xs"></div>
            </div>

            <div class="flex justify-center space-x-4">
                <button onclick="switchTab('courses')" class="px-8 py-4 rounded-2xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black font-bold text-xs shadow-xl shadow-luxury-gold/25 transition-all hover:scale-105">Explore Courses</button>
                <button onclick="switchTab('signup')" class="px-8 py-4 rounded-2xl glass-card text-luxury-gold font-bold border border-luxury-gold/40 text-xs shadow-xl transition-all hover:scale-105">Start Earning</button>
            </div>
        </section>

        <!-- 2. COURSES SECTION (16 Skills with Levels, Pricing, & Dual Instructors) -->
        <section id="tab-courses" class="tab-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-black mb-4 text-white">World-Class <span class="gold-gradient-text">Courses (16 Skills)</span></h2>
                <p class="text-luxury-grayText text-sm max-w-2xl mx-auto">Explore all 16 disciplines. Select your preferred instructor, choose your AI subtitle language, and progress through Level 1, Level 2, and Level 3.</p>
            </div>
            
            <!-- AI Subtitle Selector -->
            <div class="glass-card p-4 rounded-2xl border border-luxury-gold/30 mb-10 max-w-md mx-auto flex items-center justify-between">
                <span class="text-xs font-bold text-white flex items-center space-x-2">
                    <i data-lucide="languages" class="w-4 h-4 text-luxury-gold"></i><span>AI Subtitle Language:</span>
                </span>
                <select id="ai-subtitle-lang" class="bg-luxury-black border border-luxury-border rounded-xl px-3 py-1.5 text-xs text-white focus:border-luxury-gold focus:outline-none">
                    <option>English</option><option>Somali</option><option>Arabic</option><option>French</option><option>Spanish</option><option>German</option><option>Turkish</option><option>Portuguese</option><option>Hindi</option><option>Swahili</option>
                </select>
            </div>

            <div id="skills-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"></div>
        </section>

        <!-- 3. TEACHERS SECTION -->
        <section id="tab-teachers" class="tab-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-black mb-4 text-white">Elite <span class="gold-gradient-text">Instructors</span></h2>
                <p class="text-luxury-grayText text-sm">Every skill features two world-class masters with private upload dashboards for Level 1, Level 2, and Level 3 masterclasses.</p>
            </div>
            <div id="teachers-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8"></div>
        </section>

        <!-- 4. COMPETITION SECTION (Monthly Championship & 300 Participants) -->
        <section id="tab-competition" class="tab-content max-w-5xl mx-auto px-4 text-center">
            <div class="glass-card p-10 rounded-3xl border border-luxury-gold/40 shadow-2xl shadow-luxury-gold/10">
                <i data-lucide="trophy" class="w-16 h-16 text-luxury-gold mx-auto mb-4 animate-bounce"></i>
                <h2 class="text-4xl font-black mb-4 text-white">Monthly Innovation <span class="gold-gradient-text">Championship</span></h2>
                <p class="text-luxury-grayText text-sm mb-6 max-w-2xl mx-auto">Strictly limited to 300 verified global participants. Upload your competition video, profile photo, skill, and country to compete through the strict elimination rounds (Top 100, Top 50, Top 20, Top 10, Top 5) for the ultimate Champion Gold Trophy.</p>
                <div class="flex flex-wrap justify-center gap-4 mb-8 text-xs font-bold text-luxury-gold bg-luxury-black p-4 rounded-2xl border border-luxury-gold/30">
                    <span>Slots: 284 / 300</span>
                    <span>•</span>
                    <span>Countdown: 04d 12h 32m 15s</span>
                    <span>•</span>
                    <span>Prize: Champion Gold Trophy + Cash</span>
                </div>
                <button onclick="alert('Championship Entry Portal Open! Upload your project video, photo, skill, and country.')" class="px-8 py-4 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black font-extrabold text-xs shadow-xl transition-all hover:scale-105">Upload Competition Entry</button>
            </div>
        </section>

        <!-- 5. COMMUNITY SECTION -->
        <section id="tab-community" class="tab-content max-w-5xl mx-auto px-4">
            <div class="glass-card p-8 rounded-3xl border border-luxury-gold/30 shadow-2xl">
                <h2 class="text-3xl font-black mb-4 text-white">Global Encrypted <span class="gold-gradient-text">Community</span></h2>
                <div class="flex space-x-3 mb-4">
                    <button class="px-4 py-2 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black text-xs font-bold">Programming</button>
                    <button class="px-4 py-2 rounded-xl bg-luxury-black border border-luxury-border text-luxury-grayText text-xs font-bold">AI</button>
                    <button class="px-4 py-2 rounded-xl bg-luxury-black border border-luxury-border text-luxury-grayText text-xs font-bold">Trading</button>
                    <button class="px-4 py-2 rounded-xl bg-luxury-black border border-luxury-border text-luxury-grayText text-xs font-bold">General</button>
                </div>
                <div class="bg-luxury-black h-80 rounded-2xl p-4 mb-4 border border-luxury-border overflow-y-auto space-y-3 text-xs">
                    <div class="p-3 rounded-xl glass-card border border-luxury-gold/20"><span class="text-luxury-gold font-bold">Alex (USA):</span> Just completed Level 3 AI Engineering with automated Somali subtitles!</div>
                    <div class="p-3 rounded-xl glass-card border border-luxury-gold/20"><span class="text-luxury-gold font-bold">Fatima (Somalia):</span> The Python Masterclass instructors are exceptionally clear.</div>
                </div>
                <div class="flex space-x-3">
                    <input type="text" placeholder="Type secure message..." class="flex-grow bg-luxury-black border border-luxury-border rounded-xl px-4 py-3 text-white text-xs focus:outline-none focus:border-luxury-gold">
                    <button onclick="alert('Message broadcasted securely.')" class="px-6 py-3 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black font-bold text-xs">Send</button>
                </div>
            </div>
        </section>

        <!-- 6. MARKETPLACE (DELIVERY PAGE) -->
        <section id="tab-marketplace" class="tab-content max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-black mb-4 text-white">Luxury Delivery <span class="gold-gradient-text">Marketplace</span></h2>
                <p class="text-luxury-grayText text-sm">Order high-performance custom digital systems engineered by certified SteadyMaze professionals.</p>
            </div>
            <div id="marketplace-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8"></div>
        </section>

        <!-- 7. LOGIN SECTION -->
        <section id="tab-login" class="tab-content max-w-md mx-auto px-4">
            <div class="glass-card p-8 rounded-3xl border border-luxury-gold/30 shadow-2xl text-xs">
                <h2 class="text-2xl font-bold mb-6 text-center text-white">Secure <span class="gold-gradient-text">Login</span></h2>
                <input type="email" placeholder="Email address" class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 mb-4 text-white focus:border-luxury-gold focus:outline-none">
                <input type="password" placeholder="Password" class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 mb-6 text-white focus:border-luxury-gold focus:outline-none">
                <button onclick="switchTab('courses')" class="w-full py-3 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black font-bold text-sm shadow-xl">Login to Account</button>
            </div>
        </section>

        <!-- 8. SIGN UP SECTION (Luxury Registration) -->
        <section id="tab-signup" class="tab-content max-w-xl mx-auto px-4">
            <div class="glass-card p-8 rounded-3xl border border-luxury-gold/40 shadow-2xl text-xs space-y-4">
                <h2 class="text-2xl font-bold mb-2 text-center text-white">Create Elite <span class="gold-gradient-text">Account</span></h2>
                <input type="text" placeholder="Full Name" class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 text-white focus:border-luxury-gold focus:outline-none">
                <input type="email" placeholder="Email Address" class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 text-white focus:border-luxury-gold focus:outline-none">
                <input type="text" placeholder="Country" class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 text-white focus:border-luxury-gold focus:outline-none">
                <input type="text" placeholder="Phone Number" class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 text-white focus:border-luxury-gold focus:outline-none">
                <input type="password" placeholder="Password" class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 text-white focus:border-luxury-gold focus:outline-none">
                <select class="w-full bg-luxury-black border border-luxury-border rounded-xl p-3 text-white focus:border-luxury-gold focus:outline-none">
                    <option>Select Primary Skill Track</option>
                    <option>Web Development</option><option>Artificial Intelligence</option><option>Cryptocurrency</option><option>Graphic Design</option>
                </select>
                <button onclick="switchTab('courses')" class="w-full py-3 rounded-xl bg-gradient-to-r from-luxury-goldLight to-luxury-goldDark text-black font-extrabold text-sm shadow-xl">Complete Registration</button>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="glass-nav border-t border-luxury-border py-8 text-center text-xs text-luxury-grayText">
        <p>&copy; 2026 SteadyMaze Inc. All rights reserved. GitHub Pages Ready.</p>
    </footer>

    <!-- JavaScript -->
    <script src="script.js"></script>
</body>
</html>
