            { title: "Cloud & Backend API", price: 350, cat: "Cloud", img: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=600&q=80" }
        ];

        const deliveryGrid = document.getElementById('delivery-grid');
        deliveryData.forEach(d => {
            deliveryGrid.innerHTML += `
                <div class="glass-card rounded-3xl overflow-hidden flex flex-col justify-between">
                    <div class="h-48 overflow-hidden relative">
                        <img src="${d.img}" alt="${d.title}" class="w-full h-full object-cover">
                    </div>
                    <div class="p-6 flex-grow flex flex-col justify-between">
                        <div>
                            <span class="text-xs text-luxury-gold uppercase tracking-wider font-bold">${d.cat}</span>
                            <h3 class="text-xl font-bold text-white mt-1 mb-2">${d.title}</h3>
                            <p class="text-xs text-gray-400 mb-6">Fully custom architecture engineered for performance and scalability.</p>
                        </div>
                        <div>
                            <div class="text-lg font-black text-white mb-4">Starting From <span class="gold-gradient-text">$${d.price}</span></div>
                            <div class="flex gap-2">
                                <button onclick="alert('Order request initiated for ${d.title}')" class="flex-1 py-3 rounded-xl bg-luxury-gold text-luxury-black font-bold text-xs uppercase tracking-wider">Order Now</button>
                                <button onclick="alert('Displaying technical specs for ${d.title}')" class="px-4 py-3 rounded-xl glass-card text-xs font-bold">Details</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });

        const teachersData = [
            { name: "Dr. Alistair Vance", country: "United Kingdom", skills: "AI & Neural Networks", exp: "12 Yrs", students: "45K", rating: "4.98", img: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80" },
            { name: "Sophia De Luca", country: "Italy", skills: "Full Stack & Cloud", exp: "9 Yrs", students: "38K", rating: "4.95", img: "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=400&q=80" },
            { name: "Kenji Sato", country: "Japan", skills: "Cybersecurity & Blockchain", exp: "10 Yrs", students: "50K", rating: "4.99", img: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=80" }
        ];

        const teachersGrid = document.getElementById('teachers-grid');
        function renderTeachers(filter = '') {
            teachersGrid.innerHTML = '';
            teachersData
                .filter(t => t.name.toLowerCase().includes(filter.toLowerCase()) || t.skills.toLowerCase().includes(filter.toLowerCase()))
                .forEach(t => {
                    teachersGrid.innerHTML += `
                        <div class="glass-card p-6 rounded-3xl flex flex-col justify-between">
                            <div class="flex items-center space-x-4 mb-4">
                                <div class="w-16 h-16 rounded-2xl overflow-hidden">
                                    <img src="${t.img}" alt="${t.name}" class="w-full h-full object-cover">
                                </div>
                                <div>
                                    <h3 class="font-bold text-lg text-white">${t.name}</h3>
                                    <p class="text-xs text-luxury-purple">${t.country}</p>
                                </div>
                            </div>
                            <p class="text-xs text-gray-400 mb-4">Specialization: <strong class="text-white">${t.skills}</strong></p>
                            <div class="grid grid-cols-3 gap-2 text-center text-xs mb-6 glass-card p-3 rounded-2xl">
                                <div><span class="block font-bold text-white">${t.exp}</span>Exp</div>
                                <div><span class="block font-bold text-white">${t.students}</span>Students</div>
                                <div><span class="block font-bold text-luxury-gold">★ ${t.rating}</span>Rating</div>
                            </div>
                            <button onclick="alert('Connecting with instructor ${t.name}')" class="w-full py-3 rounded-xl glass-card font-bold text-xs uppercase tracking-wider hover:bg-white/5">Book Session</button>
                        </div>
                    `;
                });
        }
        renderTeachers();

        document.getElementById('teacher-search').addEventListener('input', (e) => {
            renderTeachers(e.target.value);
        });

        const hallGrid = document.getElementById('hall-grid');
        for(let i = 1; i <= 6; i++) {
            hallGrid.innerHTML += `
                <div class="glass-card p-6 rounded-3xl border border-luxury-gold/20 flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-4">
                        <span class="px-3 py-1 rounded-full glass-card text-xs font-black text-luxury-gold">#${i} Steady Rank</span>
                        <span class="text-xs text-gray-400">SteadyCash: $${(12000 / i).toFixed(0)}</span>
                    </div>
                    <div class="flex items-center space-x-4 mb-4">
                        <div class="w-14 h-14 rounded-2xl bg-luxury-border overflow-hidden">
                            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=300&q=80" alt="Member" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h3 class="font-bold text-white">Elite Builder ${i}</h3>
                            <p class="text-xs text-luxury-purple">Global Innovation Lead</p>
                        </div>
                    </div>
                    <div class="p-3 rounded-2xl glass-card text-xs text-gray-300 mb-4">
                        Achievements: 15 High-End Systems Deployed & Verified.
                    </div>
                    <button onclick="alert('Viewing Elite Profile')" class="w-full py-2.5 rounded-xl glass-card text-xs font-bold">View Profile</button>
                </div>
            `;
        }

        const channels = ['general', 'programming', 'python', 'javascript', 'ai', 'trading', 'cybersecurity', 'design', 'help', 'announcements'];
        const channelsList = document.getElementById('channels-list');
        channels.forEach((ch, idx) => {
            channelsList.innerHTML += `
                <button onclick="setActiveChannel('${ch}')" class="w-full text-left px-4 py-2.5 rounded-xl text-sm font-semibold transition-colors ${idx === 0 ? 'bg-luxury-purple text-white' : 'text-gray-400 hover:text-white hover:bg-white/5'}"># ${ch}</button>
            `;
        });

        function setActiveChannel(ch) {
            document.getElementById('current-channel-title').innerText = ch;
            const chatMessages = document.getElementById('chat-messages');
            chatMessages.innerHTML = `
                <div class="p-3 rounded-2xl glass-card text-sm text-gray-300">Welcome to #${ch}. Engage with world-class builders and elite peers.</div>
                <div class="p-3 rounded-2xl glass-card text-sm text-gray-300">System: Pinned messages and secure end-to-end routing active.</div>
            `;
        }
        setActiveChannel('general');

        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            if(!input.value.trim()) return;
            const chatMessages = document.getElementById('chat-messages');
            chatMessages.innerHTML += `
                <div class="p-3 rounded-2xl glass-card text-sm text-white">
                    <strong class="text-luxury-purple">You:</strong> ${input.value}
                </div>
            `;
            input.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function handleLogin(e) {
            e.preventDefault();
            alert('Login successful! Redirecting to User Dashboard...');
            switchTab('dashboard');
        }

        function handleSignup(e) {
            e.preventDefault();
            alert('Account created successfully! Welcome to SteadyMaze.');
            switchTab('dashboard');
        }
    </script>
</body>
</html>
